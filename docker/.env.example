POSTGRES_USER=app
POSTGRES_PASSWORD=app123
POSTGRES_DB=appdb

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
